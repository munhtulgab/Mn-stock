# MongoDB Atlas connection string (database name "mse" is used by the app)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mse?retryWrites=true&w=majority

# Optional: protects /api/sync from being called by strangers. Vercel Cron
# automatically sends this as a Bearer token when the env var is set.
CRON_SECRET=

# Optional: password-gates the /settings page and its API routes, since real
# LLM API keys get stored there (in MongoDB). Leave unset only for local dev.
SETTINGS_PASSWORD=

# Optional: enables the on-demand multi-LLM "AI дүн шинжилгээ" panel on stock
# pages. Without any of these (as env vars or via /settings), the app still
# works fully with the built-in rule-based signals. You can instead manage
# all four of these from the /settings page, which is usually more convenient
# since it doesn't require a redeploy — these env vars are just a fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Web Push (browser notifications when a stock's signal changes). Generate a
# keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Must match VAPID_PUBLIC_KEY above — this copy is exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
